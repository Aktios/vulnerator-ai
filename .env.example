# =============================================================================
# vulnerator-ai — environment variables template.
# Copy this file to .env and fill in the values. Do NOT put real secrets here.
#   cp .env.example .env
# =============================================================================

# --- LLM (OpenRouter) ---------------------------------------------------------
# REQUIRED. This is the SAME OpenRouter key Hermes uses as the LLM provider.
# Hermes reads it directly from this variable (not from HERMES_LLM_API_KEY).
OPENROUTER_API_KEY=

# OPTIONAL. Overrides the OpenRouter model Hermes reasons with. Empty = use the profile
# default (mistralai/mistral-large-4-0, see agent-ooda/profile/config.yaml).
# WARNING: the project deliberately uses Mistral Large because models like Claude (anthropic/*)
# refuse the authorized-offensive pentest framing (the OpenRouter/Anthropic safety filter returns
# "violative cyber content" and does not respond). Overriding with such a model may make the
# agent refuse to work.
OPENROUTER_MODEL=

# --- Hermes API server --------------------------------------------------------
# REQUIRED. Key for Hermes' internal API server (min. 8 chars). Generate one with:
#   openssl rand -hex 32
# It is also the Bearer token to drive Hermes over HTTP from an external assistant:
#   Authorization: Bearer <HERMES_API_SERVER_KEY>
HERMES_API_SERVER_KEY=

# OPTIONAL. HOST port where Hermes' OpenAI-compatible API server is published
# (the container's internal port stays 8642). Empty = 8642. You need to publish it
# to drive Hermes from an external assistant (Kiro/Claude) over HTTP without entering the TUI.
# Access is protected by the HERMES_API_SERVER_KEY Bearer; publish the port only in a
# controlled environment. If you don't want to open the port, use 'docker compose exec' (see README).
HERMES_API_HOST_PORT=

# --- AWS read-only (OPTIONAL) -------------------------------------------------
# Only if you are going to use the cloud collection tools (Prowler/ScoutSuite/Cloudsplaining).
# If you don't use them, leave these variables empty. Use read-only credentials for the account
# you are AUTHORIZED to audit.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials (STS).
AWS_SESSION_TOKEN=
AWS_REGION=

# --- Kali MCP port on the host (OPTIONAL) -------------------------------------
# HOST port where the kali-mcp server is published (the container's internal port
# stays 8900). Empty = 8900. ooda-agent reaches kali over the internal network
# (kali:8900) without relying on this; it only matters for inspection from the host.
KALI_MCP_HOST_PORT=

# --- Artifacts channel (OPTIONAL) ---------------------------------------------
# Shared token for the kali container's data channel.
KALI_ARTIFACTS_TOKEN=

# --- Prowler (OPTIONAL) -------------------------------------------------------
# These scope the cloud scan if you use Prowler. Empty = compose defaults.
PROWLER_STATUS=
PROWLER_REGIONS=
PROWLER_SERVICES=
PROWLER_TIMEOUT=
