# =============================================================================
# vulnerator-ai — plantilla de variables de entorno.
# Copia este fichero a .env y rellena los valores. NO pongas secretos reales aquí.
#   cp .env.example .env
# =============================================================================

# --- LLM (OpenRouter) ---------------------------------------------------------
# OBLIGATORIO. Es la MISMA key de OpenRouter que usa Hermes como proveedor del LLM.
# Hermes la lee de esta variable directamente (no de HERMES_LLM_API_KEY).
OPENROUTER_API_KEY=

# OPCIONAL. Modelo por defecto de OpenRouter (si se omite, usa el del perfil).
OPENROUTER_MODEL=

# --- API server de Hermes -----------------------------------------------------
# OBLIGATORIO. Clave del API server interno de Hermes (mín. 8 chars). Genera una con:
#   openssl rand -hex 32
# También es el Bearer token para pilotar Hermes por HTTP desde un asistente externo:
#   Authorization: Bearer <HERMES_API_SERVER_KEY>
HERMES_API_SERVER_KEY=

# OPCIONAL. Puerto del HOST donde se publica el API server OpenAI-compatible de Hermes
# (el puerto interno del contenedor sigue siendo 8642). Vacío = 8642. Hace falta publicarlo
# para pilotar Hermes desde un asistente externo (Kiro/Claude) por HTTP sin entrar al TUI.
# El acceso lo protege el Bearer HERMES_API_SERVER_KEY; publica el puerto solo en entorno
# controlado. Si no quieres abrir el puerto, usa 'docker compose exec' (ver README).
HERMES_API_HOST_PORT=

# --- AWS read-only (OPCIONAL) -------------------------------------------------
# Solo si vas a usar las tools de recolección cloud (Prowler/ScoutSuite/Cloudsplaining).
# Si no las usas, deja estas variables vacías. Usa credenciales read-only de la cuenta
# que estés AUTORIZADO a auditar.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Solo para credenciales temporales (STS).
AWS_SESSION_TOKEN=
AWS_REGION=

# --- Puerto del MCP de Kali en el host (OPCIONAL) -----------------------------
# Puerto del HOST donde se publica el servidor kali-mcp (el puerto interno del
# contenedor sigue siendo 8900). Vacío = 8900. ooda-agent alcanza a kali por la red
# interna (kali:8900) sin depender de esto; solo importa para inspección desde el host.
KALI_MCP_HOST_PORT=

# --- Canal de artefactos (OPCIONAL) -------------------------------------------
# Token compartido del canal de datos del contenedor kali.
KALI_ARTIFACTS_TOKEN=

# --- Prowler (OPCIONAL) -------------------------------------------------------
# Acotan el escaneo cloud si usas Prowler. Vacío = valores por defecto del compose.
PROWLER_STATUS=
PROWLER_REGIONS=
PROWLER_SERVICES=
PROWLER_TIMEOUT=
