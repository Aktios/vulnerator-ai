# =============================================================================
# hermes-pentest — plantilla de variables de entorno.
# Copia este fichero a .env y rellena los valores. NO pongas secretos reales aquí.
#   cp .env.example .env
# =============================================================================

# --- LLM (OpenRouter) ---------------------------------------------------------
# OBLIGATORIO. Es la MISMA key de OpenRouter que usa Hermes como proveedor del LLM.
# Hermes la lee de esta variable directamente (no de HERMES_LLM_API_KEY).
OPENROUTER_API_KEY=

# OPCIONAL. Modelo por defecto de OpenRouter (si se omite, usa el del perfil).
OPENROUTER_MODEL=

# --- API server de Hermes -----------------------------------------------------
# OBLIGATORIO. Clave del API server interno de Hermes (mín. 8 chars). Genera una con:
#   openssl rand -hex 32
HERMES_API_SERVER_KEY=

# --- AWS read-only (OPCIONAL) -------------------------------------------------
# Solo si vas a usar las tools de recolección cloud (Prowler/ScoutSuite/Cloudsplaining).
# Si no las usas, deja estas variables vacías. Usa credenciales read-only de la cuenta
# que estés AUTORIZADO a auditar.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Solo para credenciales temporales (STS).
AWS_SESSION_TOKEN=
AWS_REGION=

# --- Canal de artefactos (OPCIONAL) -------------------------------------------
# Token compartido del canal de datos del contenedor kali.
KALI_ARTIFACTS_TOKEN=

# --- Prowler (OPCIONAL) -------------------------------------------------------
# Acotan el escaneo cloud si usas Prowler. Vacío = valores por defecto del compose.
PROWLER_STATUS=
PROWLER_REGIONS=
PROWLER_SERVICES=
PROWLER_TIMEOUT=
