# config.yaml.example — variante documentada con placeholders.
# Copia a config.yaml del perfil y ajusta si hace falta tras validar en vivo.
# Sintaxis MCP verificada contra:
#   https://github.com/NousResearch/hermes-agent/blob/main/website/docs/user-guide/features/mcp.md

model:
  default: "mistralai/mistral-large-4-0"   # modelo de OpenRouter preparado para el pentest autorizado

mcp_servers:
  kali:
    url: "http://kali:8900"                # MCP de la Kali (contenedor `kali`). SIN headers/token.
    tools:
      # Whitelist de las tools reales del servidor kali-mcp (nombre tal como lo expone el servidor).
      include: [kali_run, kali_exec, iam_enum, iam_simulate, get_scan_status, read_tool_logs, prowler_scan, record_finding, read_findings, server_info]
      prompts: false
      resources: false
  playwright:
    url: "http://playwright-mcp:8931/mcp"  # MCP del navegador (Chromium headless) para la parte web.
    tools:
      prompts: false                       # SIN include: se exponen las tools del navegador de la imagen.
      resources: false

# Dos toolsets: ambos MCP (Kali + navegador). CERO tools nativas (browser/web nativos desactivados).
toolsets:
  - kali
  - playwright

terminal:
  backend: "local"            # Hermes no usa terminal nativa; ejecuta en la Kali via kali_run.
